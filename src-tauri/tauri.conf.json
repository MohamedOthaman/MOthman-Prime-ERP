{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Food Choice ERP",
  "version": "1.0.0",
  "identifier": "com.foodchoice.erp",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 1420",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Food Choice ERP",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {},
    "externalBin": [],
    "category": "Business",
    "shortDescription": "Enterprise ERP for Food Choice — offline-first, multi-platform",
    "longDescription": "Food Choice ERP is a full-featured enterprise resource planning system for food distribution businesses. It supports offline-first operation, real-time sync, barcode scanning, invoice management, warehouse operations, and more.",
    "copyright": "© 2024 Food Choice. All rights reserved.",
    "publisher": "Food Choice",
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "tsp": false,
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_YOUR_ED25519_PUBLIC_KEY",
      "endpoints": [
        "https://raw.githubusercontent.com/MohamedOthaman/MOthman-Prime-ERP/release-channels/channels/stable.json"
      ],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
