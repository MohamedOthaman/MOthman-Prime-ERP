# Supabase client-side publishable values
# Everything prefixed with VITE_ is embedded into the client bundle and is public.
# Use a publishable/anon key only. Never put a Supabase service role key here.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase project ref id
VITE_SUPABASE_PROJECT_ID=

# Publishable (anon) key protected by Row-Level Security. Not the service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public application URL
VITE_APP_URL=

# Extraction service URL used by the frontend/Tauri shell.
VITE_EXTRACTION_SERVICE_URL=http://127.0.0.1:8000

# Local extraction service settings
# These are read by services/extraction-service/main.py when copied into that
# service's local .env. GEMINI_API_KEY is server-side only; never prefix it with VITE_.
EXTRACTION_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:8080,http://127.0.0.1:8080
HOST=127.0.0.1
PORT=8000
GEMINI_API_KEY=
USE_MINICPM_V=false
USE_ULTRALYTICS=false

# Local safety rules:
# - Do not use production migration commands from local development.
# - Do not change RLS policies from local development.
# - Do not place SUPABASE_SERVICE_ROLE_KEY in this file.
