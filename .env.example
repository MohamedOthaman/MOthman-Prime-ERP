# ─── Supabase (client-side / publishable values) ─────────────────────────────
# Everything prefixed with VITE_ is embedded into the client bundle and is
# therefore PUBLIC. Only put publishable values here.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=
# Supabase project ref id
VITE_SUPABASE_PROJECT_ID=
# Publishable (anon) key — protected by Row-Level Security. NOT the service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public application URL
VITE_APP_URL=

# ─── OCR / AI extraction microservice ────────────────────────────────────────
# Base URL of the Python extraction service (see services/extraction-service).
# Defaults to http://127.0.0.1:8000 when unset. If you change this, make sure
# the host is allowed by the Tauri CSP `connect-src` in src-tauri/tauri.conf.json.
VITE_EXTRACTION_SERVICE_URL=http://127.0.0.1:8000

# ──────────────────────────────────────────────────────────────────────────────
# SECURITY: never place server-only secrets in this file or in any VITE_* var.
# No SUPABASE_SERVICE_ROLE_KEY, no GEMINI_API_KEY — those belong only to the
# backend / extraction service environment, never the client bundle.
