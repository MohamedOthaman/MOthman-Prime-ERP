# Gemini API Key (required for AI structuring)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: path to Poppler bin/ folder (Windows only, needed for scanned PDFs)
# Download: https://github.com/oschwartz10612/poppler-windows/releases
# POPPLER_PATH=C:\Program Files\poppler\Library\bin

# Allowed CORS origins (comma-separated). Defaults to the Tauri desktop +
# Vite dev origins. Add your web origin here if you call this service from a
# browser deployment instead of the packaged desktop app.
# EXTRACTION_ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost
