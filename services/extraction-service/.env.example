# =============================================================================
# Extraction Service — Environment Variables
#
# AI structuring (Gemini / MiniCPM) is intentionally DISABLED.
# Local OCR (pdfplumber, PaddleOCR, Tesseract) and Excel/CSV parsing remain
# fully enabled. The variables below document what was used and what can be
# re-enabled in the future — they are NOT required now.
# =============================================================================

# ─── AI structuring runtime flags ────────────────────────────────────────────
# These are read by main.py to confirm AI is intentionally off.
AI_STRUCTURING_ENABLED=false
GEMINI_RUNTIME_ENABLED=false
MINICPM_RUNTIME_ENABLED=false

# ─── OCR provider ─────────────────────────────────────────────────────────────
# EXTRACTION_PROVIDER selects the preferred OCR engine.
# Options: paddle (default) | tesseract
# (minicpm option is retained as a reference but is not active — it maps to
#  the paddle chain at runtime)
# The service automatically falls back to the next available engine on failure.
# EXTRACTION_PROVIDER=paddle

# ─── MiniCPM-V (DISABLED — future option) ────────────────────────────────────
# MiniCPM-V was used for document structuring via a local HTTP service.
# It is NOT active. Set MINICPM_RUNTIME_ENABLED=true and USE_MINICPM_V=true
# to re-enable in the future.
# See: https://github.com/OpenBMB/MiniCPM-V
# USE_MINICPM_V=false
# MINICPM_V_URL=http://127.0.0.1:8001
# MINICPM_V_MODEL=MiniCPM-V

# ─── Gemini (DISABLED — future option) ───────────────────────────────────────
# Gemini was used for AI-powered document structuring (invoice field extraction).
# It is NOT active. No GEMINI_API_KEY is required.
# To re-enable: set GEMINI_RUNTIME_ENABLED=true, add your key below, and
# restore run_structuring() in main.py.
# Get a key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Allowed CORS origins (comma-separated). Defaults to the Tauri desktop +
# Vite dev origins. Add your web origin here if you call this service from a
# browser deployment instead of the packaged desktop app.
# EXTRACTION_ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost

# ─── Ultralytics vision (optional, P4) ───────────────────────────────────────
# Set USE_ULTRALYTICS=true to enable the /detect endpoint.
# ULTRALYTICS_URL points to a separately-running Ultralytics YOLOv8 inference
# service (Docker or venv). Results feed inventory/POS vision workflows.
# USE_ULTRALYTICS=false
# ULTRALYTICS_URL=http://127.0.0.1:8002

# ─── Scanned PDFs (Windows only) ─────────────────────────────────────────────
# Path to Poppler bin/ folder, needed for scanned PDF support on Windows.
# Download: https://github.com/oschwartz10612/poppler-windows/releases
# POPPLER_PATH=C:\Program Files\poppler\Library\bin
